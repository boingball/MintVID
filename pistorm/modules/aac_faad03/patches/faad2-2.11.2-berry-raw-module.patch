+        if (hcb_2_pair_table[i]) hcb_2_pair_table[i] = (const hcb_2_pair *)((uintptr_t)hcb_2_pair_table[i] + base);
+        if (hcb_bin_table[i]) hcb_bin_table[i] = (const hcb_bin_pair *)((uintptr_t)hcb_bin_table[i] + base);
+    }
+    done = 1;
+}
